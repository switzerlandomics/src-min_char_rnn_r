
# macOS
.DS_Store
._*
/scratch/

# R session and local IDE state
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# Local environment and secrets
.Renviron
.env
.env.*
!.env.example

# Large datasets
/data/*
!/data/input.txt
!/data/README.md
!/data/.gitkeep

# Generated experiments, metrics, checkpoints and plots
/output/*
!/output/.gitkeep

# Temporary files and build artifacts
temp
tmp
/temp/
/tmp/
/*.zip

# Editor swap and backup files
*.swp
*.swo
*~
